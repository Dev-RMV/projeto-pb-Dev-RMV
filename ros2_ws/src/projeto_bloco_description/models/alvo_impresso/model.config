<?xml version="1.0"?>
<model>
  <name>alvo_impresso</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <author><name>Rodrigo Vianna</name><email>rmv@todo.todo</email></author>
  <description>
    Folha A4 com a arte real do alvo de tiro do projeto (a mesma que e impressa e que treinou o
    detector), como uma placa fina. A origem e o centro da folha; o alvo fica na face -x
    (virada para o robo, que nasce na origem olhando para +x) e na face +x (espelhada).
  </description>
</model>
