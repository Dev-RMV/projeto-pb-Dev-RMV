<?xml version="1.0"?>
<!--
  Mundo de teste do Robo Sniper: sala 6 x 6 m (paredes para o lidar), dois alvos de tiro
  (aneis vermelho/branco virados para o robo, que nasce na origem olhando para +x) e uma bola azul.
-->
<sdf version="1.6">
  <world name="alvos">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <model name="paredes">
      <static>true</static>
      <link name="link">
        <collision name="c_norte"><pose>3 0 0.25 0 0 0</pose><geometry><box><size>0.1 6 0.5</size></box></geometry></collision>
        <visual name="v_norte"><pose>3 0 0.25 0 0 0</pose><geometry><box><size>0.1 6 0.5</size></box></geometry></visual>
        <collision name="c_sul"><pose>-3 0 0.25 0 0 0</pose><geometry><box><size>0.1 6 0.5</size></box></geometry></collision>
        <visual name="v_sul"><pose>-3 0 0.25 0 0 0</pose><geometry><box><size>0.1 6 0.5</size></box></geometry></visual>
        <collision name="c_leste"><pose>0 -3 0.25 0 0 0</pose><geometry><box><size>6 0.1 0.5</size></box></geometry></collision>
        <visual name="v_leste"><pose>0 -3 0.25 0 0 0</pose><geometry><box><size>6 0.1 0.5</size></box></geometry></visual>
        <collision name="c_oeste"><pose>0 3 0.25 0 0 0</pose><geometry><box><size>6 0.1 0.5</size></box></geometry></collision>
        <visual name="v_oeste"><pose>0 3 0.25 0 0 0</pose><geometry><box><size>6 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>

    <!-- alvo: poste + aneis (discos empilhados, o menor mais a frente) -->
    <model name="alvo_1">
      <static>true</static>
      <pose>2.0 0.4 0 0 0 0</pose>
      <link name="link">
        <collision name="poste"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="poste"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="disco"><pose>0 0 0.45 0 1.5708 0</pose><geometry><cylinder><radius>0.15</radius><length>0.02</length></cylinder></geometry></collision>
        <visual name="anel_1"><pose>0 0 0.45 0 1.5708 0</pose><geometry><cylinder><radius>0.15</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="anel_2"><pose>-0.003 0 0.45 0 1.5708 0</pose><geometry><cylinder><radius>0.105</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="anel_3"><pose>-0.006 0 0.45 0 1.5708 0</pose><geometry><cylinder><radius>0.06</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="mosca"><pose>-0.009 0 0.45 0 1.5708 0</pose><geometry><cylinder><radius>0.025</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>

    <model name="alvo_2">
      <static>true</static>
      <pose>2.4 -1.2 0 0 0 0.45</pose>
      <link name="link">
        <collision name="poste"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="poste"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.015</radius><length>0.3</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Wood</name></script></material></visual>
        <collision name="disco"><pose>0 0 0.45 0 1.5708 0</pose><geometry><cylinder><radius>0.15</radius><length>0.02</length></cylinder></geometry></collision>
        <visual name="anel_1"><pose>0 0 0.45 0 1.5708 0</pose><geometry><cylinder><radius>0.15</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="anel_2"><pose>-0.003 0 0.45 0 1.5708 0</pose><geometry><cylinder><radius>0.105</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
        <visual name="anel_3"><pose>-0.006 0 0.45 0 1.5708 0</pose><geometry><cylinder><radius>0.06</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/White</name></script></material></visual>
        <visual name="mosca"><pose>-0.009 0 0.45 0 1.5708 0</pose><geometry><cylinder><radius>0.025</radius><length>0.02</length></cylinder></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Red</name></script></material></visual>
      </link>
    </model>

    <model name="bola">
      <pose>1.3 -0.5 0.12 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.2</mass><inertia><ixx>0.0012</ixx><iyy>0.0012</iyy><izz>0.0012</izz></inertia></inertial>
        <collision name="c"><geometry><sphere><radius>0.12</radius></sphere></geometry></collision>
        <visual name="v"><geometry><sphere><radius>0.12</radius></sphere></geometry>
          <material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Blue</name></script></material></visual>
      </link>
    </model>
  </world>
</sdf>
