<?xml version="1.0"?>
<!--
  Parte do URDF so para o Gazebo Classic 11 (gazebo_ros): cores, atrito e plugins.
    camera  -> /camera/image_raw + /camera/camera_info (frame camera_optical_link): mesmo topico do
               camera_publisher, entao o rastreador YOLO roda igual sobre a imagem simulada
    lidar   -> /scan (sensor_msgs/LaserScan, 360 amostras, 0,15-12 m, como um RPLIDAR A1)
    esteiras-> /cmd_vel -> /odom + TF odom->base_footprint. A lagarta nao e simulada: as duas rodas
               de cada lado sao acionadas juntas (skid steer), que e o efeito da lagarta.
    juntas  -> /joint_states (rodas e torre)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo reference="base_link"><material>Gazebo/Green</material></gazebo>
  <gazebo reference="torre_pan_link"><material>Gazebo/Green</material></gazebo>
  <gazebo reference="torre_tilt_link"><material>Gazebo/Grey</material></gazebo>
  <gazebo reference="camera_link"><material>Gazebo/DarkGrey</material></gazebo>
  <gazebo reference="lidar_link"><material>Gazebo/DarkGrey</material></gazebo>

  <!-- Atrito anisotropico: pouco atrito ao longo do eixo da roda (fdir1 = eixo do cilindro no frame
       da colisao) e atrito normal no sentido do rolamento. Com atrito igual nas duas direcoes o robo
       nao gira no lugar: o entre-eixos (0,20 m) e maior que a bitola (0,19 m) e o atrito lateral das
       4 rodas trava o giro (testado: yaw de 1 grau com 1 rad/s por 3 s; com mu1 = 0,2: 158 de 172).
       A lagarta real escorrega de lado mais facil que uma roda, entao isso tambem a aproxima melhor. -->
  <xacro:macro name="roda_gazebo" params="nome">
    <gazebo reference="${nome}_link">
      <material>Gazebo/Black</material>
      <mu1>0.2</mu1>
      <fdir1>0 0 1</fdir1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.001</minDepth>
    </gazebo>
  </xacro:macro>
  <xacro:roda_gazebo nome="roda_motriz_esq"/>
  <xacro:roda_gazebo nome="roda_motriz_dir"/>
  <xacro:roda_gazebo nome="roda_guia_esq"/>
  <xacro:roda_gazebo nome="roda_guia_dir"/>

  <!-- ===== camera ===== -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera">
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.2217</horizontal_fov>   <!-- 70 graus = hfov_graus do servidor_engajar -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>30</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <camera_name>camera</camera_name>
        <frame_name>camera_optical_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===== lidar ===== -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ===== esteiras: 2 motores, cada um puxa as duas rodas do seu lado ===== -->
  <gazebo>
    <plugin name="esteiras" filename="libgazebo_ros_diff_drive.so">
      <update_rate>30</update_rate>
      <num_wheel_pairs>2</num_wheel_pairs>
      <left_joint>roda_motriz_esq_joint</left_joint>
      <right_joint>roda_motriz_dir_joint</right_joint>
      <left_joint>roda_guia_esq_joint</left_joint>
      <right_joint>roda_guia_dir_joint</right_joint>
      <wheel_separation>${bitola}</wheel_separation>
      <wheel_separation>${bitola}</wheel_separation>
      <wheel_diameter>${2 * roda_r}</wheel_diameter>
      <wheel_diameter>${2 * roda_r}</wheel_diameter>
      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>3.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ===== estados das juntas ===== -->
  <gazebo>
    <plugin name="estados_juntas" filename="libgazebo_ros_joint_state_publisher.so">
      <update_rate>20</update_rate>
      <joint_name>roda_motriz_esq_joint</joint_name>
      <joint_name>roda_motriz_dir_joint</joint_name>
      <joint_name>roda_guia_esq_joint</joint_name>
      <joint_name>roda_guia_dir_joint</joint_name>
      <joint_name>torre_pan_joint</joint_name>
      <joint_name>torre_tilt_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
